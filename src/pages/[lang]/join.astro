---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { languages, tr, asset, route, contactEmail, type Lang } from '../../lib/site';
export function getStaticPaths(){return languages.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Lang;
const subject=encodeURIComponent(tr(lang,'大山研究室の見学・配属について','Inquiry about visiting or joining Oyama Laboratory'));
---
<Layout lang={lang} title={tr(lang,'配属・見学案内','Join the laboratory')}>
  <PageIntro eyebrow="JOIN US" title={tr(lang,'配属・研究室見学','Graduate study and laboratory visits')} description={tr(lang,'研究室への配属、大学院での研究、研究室見学についてご案内します。希望する研究テーマや参加方法については、事前にお問い合わせください。','Information about graduate study, joining the laboratory and laboratory visits. Please contact us in advance to discuss research topics and participation.')} />
  <div class="container page-content"><div class="content-two-column"><div>
    <article class="prose"><h2>{tr(lang,'研究室見学・配属について','Laboratory visits and placement')}</h2><p>{tr(lang,'研究室見学や、研究テーマ・配属方法についてのご相談を受け付けています。現在の所属、学年、興味のあるテーマを添えて、お気軽にご連絡ください。','We welcome inquiries about laboratory visits, research topics and routes to joining the lab. Please tell us your current affiliation, stage of study and research interests.')}</p></article>
    <div class="contact-card" style="margin:28px 0 42px"><p class="eyebrow">CONTACT / AKIRA OYAMA</p><h2>{tr(lang,'見学・配属の相談をする','Discuss a visit or joining the lab')}</h2><a href={`mailto:${contactEmail}?subject=${subject}`}>{contactEmail} ↗</a><p>{tr(lang,'お問い合わせは大山聖まで。来訪前に日程をご相談ください。','Please contact Akira Oyama to arrange a visit in advance.')}</p></div>
    <h2 style="font-size:26px;margin-bottom:24px">{tr(lang,'学生として研究するには','Routes for students')}</h2>
    <div class="join-paths"><section class="join-path"><p class="eyebrow">01 / GRADUATE STUDY</p><h3>{tr(lang,'東京大学大学院から参加する','Graduate study at the University of Tokyo')}</h3><p>{tr(lang,'東京大学大学院工学系研究科の航空宇宙工学分野で学び、大山研究室での研究を希望する方法があります。出願・入試・配属の条件については、大学の最新の公式案内を確認し、事前にご相談ください。','One route is graduate study in aeronautics and astronautics at the University of Tokyo. Consult the university’s current admissions information and contact us to discuss research interests and laboratory placement.')}</p><a class="text-link" href="https://www.aerospace.t.u-tokyo.ac.jp/">{tr(lang,'東京大学 航空宇宙工学専攻','University of Tokyo — Aeronautics and Astronautics')} ↗</a></section>
    <section class="join-path"><p class="eyebrow">02 / RESEARCH STUDENTS & TRAINEES</p><h3>{tr(lang,'所属大学を通じて宇宙研で研究する','Research at ISAS through your home university')}</h3><p>{tr(lang,'特別共同利用研究員や技術研修生などの制度があります。所属大学の指導教員との相談が必要です。対象者、募集時期、申請手続きは、宇宙科学研究所の公式案内を確認してください。','Programs include Special Joint Research Students and Technical Trainees. Discuss the arrangement with your supervisor at your home university. Eligibility, application schedules and procedures are described in the current official ISAS information.')}</p><a class="text-link" href="https://www.isas.jaxa.jp/researchers/graduate/">{tr(lang,'宇宙科学研究所 大学院教育','ISAS graduate education')} ↗</a></section>
    <section class="join-path"><p class="eyebrow">03 / AFFILIATED GRADUATE PROGRAMS</p><h3>{tr(lang,'連携大学院などの制度を利用する','Affiliated graduate-school arrangements')}</h3><p>{tr(lang,'JAXAの連携大学院など、所属や研究内容に応じた参加方法があります。利用できる制度と研究指導について、まずはご相談ください。','Other arrangements may be possible through JAXA-affiliated graduate schools, depending on your affiliation and research project. Contact us to discuss the available routes and research supervision.')}</p></section></div>
    <article class="prose"><h2>{tr(lang,'ポスドク・共同研究をお考えの方へ','Postdoctoral research and collaboration')}</h2><p>{tr(lang,'受け入れ可能なテーマや制度については、時期によって異なります。ご自身の研究内容や関心を添えてお問い合わせください。募集中のポストを掲載していない場合も、まずはご相談ください。','Available research topics and funding arrangements vary over time. Please contact us with an outline of your research and interests to discuss postdoctoral opportunities or collaboration.')}</p><a href="https://www.jaxa.jp/about/employ/">{tr(lang,'JAXAの採用情報','JAXA recruitment information')}</a></article>
  </div><aside class="image-stack"><figure><img src={asset('images/2025top.JPG')} alt={tr(lang,'大山研究室の集合写真（2025年）','Oyama Laboratory group photograph, 2025')} width="800" height="600"/><figcaption>{tr(lang,'研究室の集合写真（2025年）','Laboratory group photograph, 2025')}</figcaption></figure><figure><img src={asset('images/tunnel01.jpg')} alt={tr(lang,'研究室の実験設備','Laboratory experimental equipment')} width="800" height="600" loading="lazy"/><figcaption>{tr(lang,'数値解析と実験を組み合わせて研究に取り組みます。','Our research connects simulation and experiment.')}</figcaption></figure><a class="text-link" href={route(lang,'research')}>{tr(lang,'研究テーマを見る','Explore our research themes')} →</a><a class="text-link" href={route(lang,'contact')}>{tr(lang,'研究室へのアクセス','Getting to the laboratory')} →</a></aside></div></div>
</Layout>
