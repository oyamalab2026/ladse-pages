---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import JoinBand from '../../components/JoinBand.astro';
import ResearchCard from '../../components/ResearchCard.astro';
import { languages, tr, route, asset, dateLabel, newsOrder, type Lang } from '../../lib/site';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const research = (await getCollection('research', ({ data }) => data.lang === lang)).sort((a,b) => a.data.order-b.data.order);
const news = (await getCollection('news')).sort(newsOrder).slice(0,6);
---
<Layout lang={lang} title={tr(lang, '大山研究室 — 宇宙を飛ぶ、その設計を探究する', 'Oyama Laboratory — Exploring flight and design beyond Earth')}>
  <section class="hero"><div class="container">
    <div class="hero-inner">
      <div class="hero-copy"><p class="eyebrow">AERODYNAMICS × DESIGN × SPACE</p><h1 class:list={{ 'hero-en': lang === 'en' }}>{tr(lang, 'まだ見ぬ空に、\n新しい設計を。', 'Designing flight.\nBeyond Earth.')}</h1><p class="hero-lead">{tr(lang, '火星の薄い大気を飛ぶ。流れを理解し、設計の可能性を広げる。大山研究室は、数値解析・風洞実験・飛行試験を通じて、宇宙航空工学の新しい問いに取り組みます。', 'Fly in the thin atmosphere of Mars. Understand complex flows. Explore new design possibilities. At Oyama Lab, we connect numerical simulation, wind-tunnel experiments and flight tests to investigate questions in aerospace engineering.')}</p><div class="hero-actions"><a class="button" href={route(lang,'research')}>{tr(lang,'研究を知る','Explore our research')}<span aria-hidden="true">↗</span></a><a class="button button-outline" href={route(lang,'join')}>{tr(lang,'配属・見学を考えている方へ','Join the laboratory')}<span aria-hidden="true">→</span></a></div></div>
      <figure class="hero-visual"><img src={asset('images/mars-airplane.jpg')} alt={tr(lang,'火星の上空を飛行する飛行機の概念図','Concept illustration of an airplane flying over Mars')} width="900" height="800" fetchpriority="high" /><figcaption class="hero-caption">EXPLORING THE MARTIAN SKY<strong>{tr(lang,'火星飛行機の概念図','Mars airplane concept')}</strong></figcaption></figure>
    </div>
    <div class="hero-footnote"><span>OYAMA LABORATORY · JAXA / ISAS</span><span>SAGAMIHARA, JAPAN <span aria-hidden="true">↗</span></span></div>
  </div></section>
  <section class="section research-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">01 / RESEARCH</p><h2>{tr(lang,'宇宙への問いを、解き明かす。','Questions that take us further.')}</h2></div><p>{tr(lang,'計算と実験、理論と設計を行き来しながら、航空宇宙の課題に取り組んでいます。','We move between computation and experiment, theory and design, to investigate challenges in aerospace engineering.')}</p></div><div class="research-grid home-research">{research.map(entry => <ResearchCard entry={entry} lang={lang} />)}</div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">02 / LATEST NEWS</p><h2>{tr(lang,'研究室のいま','From the laboratory')}</h2></div><a class="text-link" href={route(lang,'news')}>{tr(lang,'すべてのニュース','All news')}<span aria-hidden="true">→</span></a></div><div class="news-list">{news.map(item => <a class="news-row" href={route('ja',`news/${item.id}`)}><time class="news-date" datetime={item.data.date?.toISOString().slice(0,10)}>{dateLabel(item.data.date,item.data.datePrecision)}</time><div><h3 lang="ja">{item.data.title}</h3>{lang==='en' && <span class="news-language">ORIGINAL ARTICLE IN JAPANESE</span>}</div><span class="news-arrow" aria-hidden="true">↗</span></a>)}</div></div></section>
  <section class="section research-section"><div class="container"><div class="lab-story"><figure><img src={asset('images/2025top.JPG')} alt={tr(lang,'大山研究室のメンバーの集合写真','Group photograph of Oyama Laboratory members')} width="900" height="650" loading="lazy" /><figcaption>{tr(lang,'研究室の集合写真（2025年）','Laboratory group photograph, 2025')}</figcaption></figure><div><p class="eyebrow">03 / PEOPLE & ENVIRONMENT</p><h2>{tr(lang,'対話し、試し、\n宇宙へつなぐ。','Think together.\nTest ideas. Go further.')}</h2><p>{tr(lang,'JAXA宇宙科学研究所を拠点に、学生と研究者がそれぞれのテーマに向き合っています。数値シミュレーションと実験の両方に触れ、研究成果を学会や論文で発信していきます。','Based at JAXA’s Institute of Space and Astronautical Science, students and researchers pursue their own questions. Our work spans numerical simulation and experiments, with results shared through conferences and publications.')}</p><a class="text-link" href={route(lang,'people')}>{tr(lang,'研究室のメンバーを見る','Meet the people')}<span aria-hidden="true">→</span></a></div></div><div class="environment-teasers">{[
    ['images/1815.jpg','研究の拠点','A place to work','居室・研究室','Laboratory spaces'],
    ['images/workstations.jpg','計算から探る','Explore through computation','数値解析・設計最適化','Simulation & design optimization'],
    ['images/tunnel01.jpg','実験で確かめる','Put ideas to the test','風洞・計測設備','Wind tunnels & measurement'],
  ].map(([image,ja,en,subJa,subEn]) => <a href={route(lang,'environment')}><img src={asset(image)} alt={tr(lang,ja,en)} width="600" height="400" loading="lazy"/><h3>{tr(lang,ja,en)} <span aria-hidden="true">↗</span></h3><p>{tr(lang,subJa,subEn)}</p></a>)}</div></div></section>
  <JoinBand lang={lang}/>
</Layout>
