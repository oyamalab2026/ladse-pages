---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import JoinBand from '../../components/JoinBand.astro';
import ResearchCard from '../../components/ResearchCard.astro';
import NewsList from '../../components/NewsList.astro';
import { languages, tr, route, asset, newsOrder, type Lang } from '../../lib/site';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const research = (await getCollection('research', ({ data }) => data.lang === lang)).sort((a,b) => a.data.order-b.data.order);
const news = (await getCollection('news')).sort(newsOrder).slice(0,6);
---
<Layout lang={lang} title={tr(lang, '大山研究室', 'Oyama Laboratory')}>
  <section class="hero"><div class="container">
    <div class="hero-inner">
      <div class="hero-copy"><p class="eyebrow">JAXA / ISAS</p><h1 class:list={{ 'hero-en': lang === 'en' }}>{tr(lang, '大山研究室', 'Oyama Laboratory')}</h1><p class="hero-lead">{tr(lang, '大山研究室は、JAXA宇宙科学研究所を拠点に、空気力学および宇宙機の設計に関する研究を行っています。数値流体解析、風洞実験、飛行試験、多目的設計最適化を用いて、火星航空機や流体制御などの課題に取り組んでいます。', 'Oyama Laboratory at JAXA’s Institute of Space and Astronautical Science studies aerodynamics and spacecraft design. Our research uses computational fluid dynamics, wind-tunnel experiments, flight tests and multiobjective design optimization to investigate Mars aircraft, flow control and related topics.')}</p><div class="hero-actions"><a class="button" href={route(lang,'research')}>{tr(lang,'研究紹介','Research themes')}<span aria-hidden="true">↗</span></a><a class="button button-outline" href={route(lang,'join')}>{tr(lang,'配属・見学案内','Graduate study and visits')}<span aria-hidden="true">→</span></a></div></div>
      <figure class="hero-visual"><img src={asset('images/mars-airplane.jpg')} alt={tr(lang,'火星の上空を飛行する飛行機の概念図','Concept illustration of an airplane flying over Mars')} width="900" height="800" fetchpriority="high" /><figcaption class="hero-caption">MARS AIRCRAFT<strong>{tr(lang,'火星飛行機の概念図','Mars airplane concept')}</strong></figcaption></figure>
    </div>
    <div class="hero-footnote"><span>OYAMA LABORATORY · JAXA / ISAS</span><span>SAGAMIHARA, JAPAN <span aria-hidden="true">↗</span></span></div>
  </div></section>
  <section class="section research-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">01 / RESEARCH</p><h2>{tr(lang,'研究テーマ','Research themes')}</h2></div><p>{tr(lang,'数値解析と実験を用いて、以下の研究テーマに取り組んでいます。','Our research combines numerical analysis and experiments in the following areas.')}</p></div><div class="research-grid home-research">{research.map(entry => <ResearchCard entry={entry} lang={lang} />)}</div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">02 / LATEST NEWS</p><h2>{tr(lang,'最新ニュース','Latest news')}</h2></div><a class="text-link" href={route(lang,'news')}>{tr(lang,'すべてのニュース','All news')}<span aria-hidden="true">→</span></a></div><NewsList items={news} lang={lang}/></div></section>
  <section class="section research-section"><div class="container"><div class="lab-story"><figure><img src={asset('images/2025top.JPG')} alt={tr(lang,'大山研究室のメンバーの集合写真','Group photograph of Oyama Laboratory members')} width="900" height="650" loading="lazy" /><figcaption>{tr(lang,'研究室の集合写真（2025年）','Laboratory group photograph, 2025')}</figcaption></figure><div><p class="eyebrow">03 / PEOPLE & ENVIRONMENT</p><h2>{tr(lang,'研究室紹介','About the laboratory')}</h2><p>{tr(lang,'JAXA宇宙科学研究所に所属する教員と、各大学から参加する学生・研究者が研究に取り組んでいます。数値シミュレーションと実験による研究を行い、学術論文や学会発表を通じて成果を公表しています。','Faculty at JAXA / ISAS work with students and researchers from participating universities. Research combines numerical simulation and experiments, with results reported in journals and at conferences.')}</p><a class="text-link" href={route(lang,'people')}>{tr(lang,'研究室のメンバーを見る','Meet the people')}<span aria-hidden="true">→</span></a></div></div><div class="environment-teasers">{[
    ['images/1815.jpg','研究室','Laboratory spaces','居室・研究室','Laboratory spaces'],
    ['images/workstations.jpg','計算設備','Computing facilities','数値解析・設計最適化','Simulation & design optimization'],
    ['images/tunnel01.jpg','実験設備','Experimental facilities','風洞・計測設備','Wind tunnels & measurement'],
  ].map(([image,ja,en,subJa,subEn]) => <a href={route(lang,'environment')}><img src={asset(image)} alt={tr(lang,ja,en)} width="600" height="400" loading="lazy"/><h3>{tr(lang,ja,en)} <span aria-hidden="true">↗</span></h3><p>{tr(lang,subJa,subEn)}</p></a>)}</div></div></section>
  <JoinBand lang={lang}/>
</Layout>
