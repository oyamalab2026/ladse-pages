---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { languages, tr, contactEmail, type Lang } from '../../lib/site';
export function getStaticPaths(){return languages.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Lang;
---
<Layout lang={lang} title={tr(lang,'アクセス・お問い合わせ','Access & contact')}>
  <PageIntro eyebrow="ACCESS & CONTACT" title={tr(lang,'アクセス・お問い合わせ','Access and contact')} description={tr(lang,'JAXA相模原キャンパス・宇宙科学研究所に研究室があります。研究室への来訪は、事前にご連絡ください。','Our laboratory is based at the Institute of Space and Astronautical Science, JAXA Sagamihara Campus. Please arrange laboratory visits in advance.')} />
  <div class="container page-content"><div class="content-two-column"><article class="prose"><h2>{tr(lang,'所在地','Address')}</h2><p>{tr(lang,'〒252-5210 神奈川県相模原市中央区由野台3-1-1','3-1-1 Yoshinodai, Chuo-ku, Sagamihara, Kanagawa 252-5210, Japan')}<br/>{tr(lang,'宇宙航空研究開発機構 宇宙科学研究所 大山研究室','Oyama Laboratory, Institute of Space and Astronautical Science, Japan Aerospace Exploration Agency')}</p><h2>{tr(lang,'キャンパスへのアクセス','Getting to the campus')}</h2><p>{tr(lang,'最寄り駅はJR横浜線の淵野辺駅です。キャンパスまでの経路や交通案内は、宇宙科学研究所の公式サイトをご確認ください。','The nearest railway station is Fuchinobe on the JR Yokohama Line. See the official ISAS access information for current directions and transport options.')}</p><a class="button button-outline" href="https://www.isas.jaxa.jp/access/">{tr(lang,'ISAS公式アクセス案内','Official ISAS access information')}<span aria-hidden="true">↗</span></a><h2>{tr(lang,'来訪時のお願い','Before your visit')}</h2><p>{tr(lang,'研究室見学や打ち合わせの際は、事前に日程・待ち合わせ場所をご相談ください。キャンパスでは門衛所の案内に従って受付をお願いします。','Please contact us in advance to confirm the date and meeting location. Follow the instructions at the campus gate when arriving.')}</p></article><aside class="contact-card"><p class="eyebrow">CONTACT</p><h2>{tr(lang,'大山 聖','Akira Oyama')}</h2><p>{tr(lang,'宇宙科学研究所 宇宙飛翔工学研究系 教授','Professor, Department of Space Flight Systems, ISAS / JAXA')}</p><a href={`mailto:${contactEmail}`}>{contactEmail} ↗</a><p>{tr(lang,'研究内容、配属、研究室見学、共同研究について、お問い合わせください。','For inquiries about research, joining the lab, visits and collaboration.')}</p></aside></div></div>
</Layout>
