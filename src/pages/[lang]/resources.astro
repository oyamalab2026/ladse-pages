---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { languages, tr, route, resources, downloads, type Lang } from '../../lib/site';
export function getStaticPaths(){return languages.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Lang;
---
<Layout lang={lang} title={tr(lang,'公開資料・アーカイブ','Resources & archives')}>
  <PageIntro eyebrow="RESOURCES & ARCHIVES" title={tr(lang,'公開資料・アーカイブ','Resources and archives')} description={tr(lang,'公開済みのベンチマーク問題、講義資料、過去プロジェクトをまとめています。資料の内容・所属・日付は、掲載当時のものです。','Published benchmark problems, lecture materials and past projects. The content, affiliations and dates reflect the original publication.')} />
  <div class="container page-content"><div class="resources-grid">{resources.groups.map(group=><a class="resource-card" href={group.id==='lectures'?'#lectures':group.path}><p class="eyebrow">{group.id.replaceAll('-',' ')}</p><h2>{group.title[lang]}</h2><p>{group.description[lang]}</p><span class="text-link">{tr(lang,'資料を見る','View resources')} →</span></a>)}</div>
  <section class="prose" style="margin-top:65px" id="lectures"><h2>{tr(lang,'講義資料','Lecture materials')}</h2><p>{tr(lang,'ファイル名と年度は旧HPの構成を引き継いでいます。','File names and years follow the structure of the previous website.')}</p><ul class="download-list">{resources.lectures.map(item=><li><a href={item.url}>{item.path.replace(/^lecture\//,'')}</a></li>)}</ul></section>
  <section class="prose" style="margin-top:55px"><h2>{tr(lang,'大型の配布ファイル','Large downloads')}</h2><p>{tr(lang,'大型のPDF・動画・ベンチマークデータは、研究室のGitHub Releasesからダウンロードする構成です。','Large PDFs, video and benchmark datasets are distributed through the laboratory’s GitHub Releases.')}</p><ul class="download-list">{downloads.map(item=><li><a href={item.url}>{item.path}</a><small>{(item.bytes/1024/1024).toFixed(1)} MiB</small></li>)}</ul></section>
  <div style="margin-top:45px"><a class="text-link" href="/archive/index.html">{tr(lang,'旧HPの保存版を見る','View the archived website')} →</a><br/><a class="back-link" href={route(lang)}>{tr(lang,'トップに戻る','Back to home')}</a></div></div>
</Layout>
