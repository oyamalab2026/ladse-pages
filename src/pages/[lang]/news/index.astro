---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import NewsList from '../../../components/NewsList.astro';
import { languages, tr, newsOrder, type Lang } from '../../../lib/site';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const news = (await getCollection('news')).sort(newsOrder);
const years = [...new Set(news.map(item => item.data.date?.getUTCFullYear() ?? 0))].sort((a, b) => b - a);
---
<Layout lang={lang} title={tr(lang, 'ニュース', 'News')}>
  <PageIntro eyebrow="NEWS" title={tr(lang, 'ニュース', 'News')} description={tr(lang, '学会発表、受賞、研究室行事などの活動を掲載しています。', 'Conference presentations, awards and laboratory activities.')} />
  <div class="container page-content">
    <nav class="tag-list news-years" aria-label={tr(lang, '年別ニュース', 'News by year')}>
      {years.map(year => <a class="tag" href={`#year-${year}`}>{year || tr(lang, '日付未記載', 'Undated')}</a>)}
    </nav>
    {years.map(year => <section class="people-group" id={`year-${year}`}>
      <h2>{year || tr(lang, '日付未記載', 'Undated')}</h2>
      <NewsList items={news.filter(item => (item.data.date?.getUTCFullYear() ?? 0) === year)} lang={lang}/>
    </section>)}
  </div>
</Layout>
