{
  "name": "ladse-pages",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build && node scripts/finalize-build.mjs && node scripts/validate-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "publish:assets": "node scripts/publish-assets.mjs",
    "publish:prepare": "node scripts/prepare-publication.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "3.7.4",
    "@playwright/test": "1.64.1",
    "astro": "7.4.2",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "wrangler": "4.151.3"
  }
}
